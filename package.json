{
  "name": "naga-portfolio-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check-structure && npm run check-content && npm run check-sitemap-sync && next build",
    "start": "next start",
    "check-content": "node scripts/check-content.mjs",
    "check-sitemap-sync": "node scripts/check-sitemap-sync.mjs",
    "parity": "node scripts/parity.mjs",
    "lint": "tsc --noEmit",
    "check-structure": "python3 scripts/verify-structure.py",
    "check": "npm run check-structure && npm run check-content && npm run check-sitemap-sync && npm run check-legacy-js && npm run lint",
    "check-legacy-js": "python3 scripts/check-legacy-js.py"
  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next-mdx-remote": "5.0.0",
    "gray-matter": "4.0.3",
    "zod": "3.25.76",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rehype-katex": "7.0.1",
    "katex": "0.16.22",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/node": "22.18.6",
    "@types/ms": "2.1.0",
    "@types/unist": "3.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
